# Discord Bot Configuration
# 1. Go to https://discord.com/developers/applications
# 2. Create a new application
# 3. Go to the Bot section
# 4. Copy your token below (NO quotes around it)

DISCORD_TOKEN=your_super_secret_token_here

# Optional: Custom database path (defaults to fishing_game.db in current directory)
# DATABASE_PATH=/path/to/custom/fishing_game.db